{
  "name": "livistone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 0.0.0.0",
    "build": "node scripts/verify-audio-assets.mjs && tsc --noEmit && bun --bun vite build",
    "preview": "bun --bun vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "docs:sync": "bash scripts/sync-agent-docs.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:hosts": "node scripts/check-hosts.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.3",
    "@types/three": "^0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.12.0"
  }
}
